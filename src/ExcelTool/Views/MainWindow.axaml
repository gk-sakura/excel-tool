<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExcelTool.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ExcelTool.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        
        Width="1120"
        Height="650"
        MinWidth="1000"
        MinHeight="580"
        
        Title="Excel工具箱">
    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"></Setter>
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="CornerRadius" Value="8"></Setter>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1D4ED8"></Setter>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#1E40AF"></Setter>
        </Style>
    </Window.Styles>
    <Grid>
        <Image
            Source="/Assets/background.jpg"
            Stretch="UniformToFill"
            Opacity="0.85"
            IsHitTestVisible="False"/>
        <Grid
            Margin="12"
            RowDefinitions="Auto, Auto, Auto, *, Auto"
            RowSpacing="12">
            <Grid 
                Grid.Row="0"
                ColumnDefinitions="100, Auto, Auto"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Text="选择功能"/>
                </Border>
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding Functions}"
                    SelectedItem="{Binding SelectedFunction, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"></TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button 
                    Grid.Column="2"
                    Content="开始执行"
                    Classes="primary"
                    Command="{Binding ExecuteCommandCommand}"/>
            </Grid>
            <Grid
                IsVisible="{Binding ShowSelectSourceFolder}"
                Grid.Row="1"
                ColumnDefinitions="100, Auto, Auto"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Text="文件路径"/>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Padding="12 0"
                        Text="{Binding SourceFolderPath}"/>
                </Border>
                <Button
                    Grid.Column="2"
                    Content="选择"
                    Classes="primary"
                    Command="{Binding SelectSourceFolderCommand}"/>
            </Grid>
            <Grid
                IsVisible="{Binding ShowSelectTargetFolder}"
                Grid.Row="2"
                ColumnDefinitions="100, Auto, Auto"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Text="保存路径"/>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Padding="12 0"
                        Text="{Binding TargetFolderPath}"/>
                </Border>
                <Button
                    Grid.Column="2"
                    Content="选择"
                    Classes="primary"
                    Command="{Binding SelectTargetFolderCommand}"/>
            </Grid>
            <Grid
                IsVisible="{Binding ShowSelectSourceFile}"
                Grid.Row="1"
                ColumnDefinitions="100, Auto, Auto"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="文件路径"
                        Foreground="#1F2937"/>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Padding="12 0"
                        Text="{Binding SourceFilePath}"/>
                </Border>
                <Button
                    Grid.Column="2"
                    Content="选择"
                    Classes="primary"
                    Command="{Binding SelectSourceFileCommand}"/>
            </Grid>
            <Grid
                IsVisible="{Binding ShowSelectSourceFiles}"
                Grid.Row="1"
                ColumnDefinitions="*">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="180, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Background="#99FFFFFF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1F2937" Text="研发人员考勤源表"/></Border>
                        <Border Grid.Column="1" Background="#99FFFFFF" CornerRadius="6"><TextBlock VerticalAlignment="Center" Foreground="#1F2937" Padding="12 6" TextWrapping="Wrap" Text="{Binding RdAttendanceDisplayPath}" ToolTip.Tip="{Binding RdAttendanceFilePath}"/></Border>
                        <Button Grid.Column="2" Content="选择" Classes="primary" Command="{Binding SelectRdAttendanceFileCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="180, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Background="#99FFFFFF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1F2937" Text="研发项目及周期汇总表"/></Border>
                        <Border Grid.Column="1" Background="#99FFFFFF" CornerRadius="6"><TextBlock VerticalAlignment="Center" Foreground="#1F2937" Padding="12 6" TextWrapping="Wrap" Text="{Binding RdProjectSummaryDisplayPath}" ToolTip.Tip="{Binding RdProjectSummaryFilePath}"/></Border>
                        <Button Grid.Column="2" Content="选择" Classes="primary" Command="{Binding SelectRdProjectSummaryFileCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="180, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Background="#99FFFFFF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1F2937" Text="人员与项目关系匹配表"/></Border>
                        <Border Grid.Column="1" Background="#99FFFFFF" CornerRadius="6"><TextBlock VerticalAlignment="Center" Foreground="#1F2937" Padding="12 6" TextWrapping="Wrap" Text="{Binding RdPersonProjectDisplayPath}" ToolTip.Tip="{Binding RdPersonProjectFilePath}"/></Border>
                        <Button Grid.Column="2" Content="选择" Classes="primary" Command="{Binding SelectRdPersonProjectFileCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="180, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Background="#99FFFFFF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1F2937" Text="人员花名册及基础信息"/></Border>
                        <Border Grid.Column="1" Background="#99FFFFFF" CornerRadius="6"><TextBlock VerticalAlignment="Center" Foreground="#1F2937" Padding="12 6" TextWrapping="Wrap" Text="{Binding RdStaffDisplayPath}" ToolTip.Tip="{Binding RdStaffFilePath}"/></Border>
                        <Button Grid.Column="2" Content="选择" Classes="primary" Command="{Binding SelectRdStaffFileCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="180, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Background="#99FFFFFF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1F2937" Text="考勤规则拆解表"/></Border>
                        <Border Grid.Column="1" Background="#99FFFFFF" CornerRadius="6"><TextBlock VerticalAlignment="Center" Foreground="#1F2937" Padding="12 6" TextWrapping="Wrap" Text="{Binding RdRulesDisplayPath}" ToolTip.Tip="{Binding RdRulesFilePath}"/></Border>
                        <Button Grid.Column="2" Content="选择" Classes="primary" Command="{Binding SelectRdRulesFileCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="180, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Background="#99FFFFFF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1F2937" Text="历史月份锁定表（可选）"/></Border>
                        <Border Grid.Column="1" Background="#99FFFFFF" CornerRadius="6"><TextBlock VerticalAlignment="Center" Foreground="#1F2937" Padding="12 6" TextWrapping="Wrap" Text="{Binding RdHistoryLockDisplayPath}" ToolTip.Tip="{Binding RdHistoryLockFilePath}"/></Border>
                        <Button Grid.Column="2" Content="选择" Classes="primary" Command="{Binding SelectRdHistoryLockFileCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="180, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Background="#99FFFFFF" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1F2937" Text="日志与分配控制表（可选）"/></Border>
                        <Border Grid.Column="1" Background="#99FFFFFF" CornerRadius="6"><TextBlock VerticalAlignment="Center" Foreground="#1F2937" Padding="12 6" TextWrapping="Wrap" Text="{Binding RdControlTableDisplayPath}" ToolTip.Tip="{Binding RdControlTableFilePath}"/></Border>
                        <Button Grid.Column="2" Content="选择" Classes="primary" Command="{Binding SelectRdControlTableFileCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <ProgressBar
                Grid.Row="4"
                Minimum="0"
                Maximum="100"
                Value="{Binding Progress}"/>
        </Grid>
    </Grid>

</Window>
