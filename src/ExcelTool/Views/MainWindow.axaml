<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExcelTool.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ExcelTool.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        
        Width="900"
        Height="600"
        
        Title="Excel工具箱">
    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"></Setter>
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="CornerRadius" Value="8"></Setter>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1D4ED8"></Setter>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#1E40AF"></Setter>
        </Style>
    </Window.Styles>
    <Grid>
        <Image
            Source="/Assets/background.jpg"
            Stretch="UniformToFill"
            Opacity="0.85"
            IsHitTestVisible="False"/>
        <Grid
            Margin="12"
            RowDefinitions="Auto, Auto, Auto, *, Auto"
            RowSpacing="12">
            <Grid 
                Grid.Row="0"
                ColumnDefinitions="100, Auto, Auto"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Text="选择功能"/>
                </Border>
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding Functions}"
                    SelectedItem="{Binding SelectedFunction, Mode=TwoWay}">
                </ComboBox>
                <Button 
                    Grid.Column="2"
                    Content="开始执行"
                    Classes="primary"
                    Command="{Binding ExecuteCommandCommand}"/>
            </Grid>
            <Grid
                IsVisible="{Binding ShowSelectSourceFolder}"
                Grid.Row="1"
                ColumnDefinitions="100, Auto, Auto"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Text="文件路径"/>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Padding="12 0"
                        Text="{Binding SourceFolderPath}"/>
                </Border>
                <Button
                    Grid.Column="2"
                    Content="选择"
                    Classes="primary"
                    Command="{Binding SelectSourceFolderCommand}"/>
            </Grid>
            <Grid
                IsVisible="{Binding ShowSelectTargetFolder}"
                Grid.Row="2"
                ColumnDefinitions="100, Auto, Auto"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Text="保存路径"/>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Padding="12 0"
                        Text="{Binding TargetFolderPath}"/>
                </Border>
                <Button
                    Grid.Column="2"
                    Content="选择"
                    Classes="primary"
                    Command="{Binding SelectTargetFolderCommand}"/>
            </Grid>
            <Grid
                IsVisible="{Binding ShowSelectSourceFile}"
                Grid.Row="1"
                ColumnDefinitions="100, Auto, Auto"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="文件路径"
                        Foreground="#1F2937"/>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="#99FFFFFF"
                    CornerRadius="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#1F2937"
                        Padding="12 0"
                        Text="{Binding SourceFilePath}"/>
                </Border>
                <Button
                    Grid.Column="2"
                    Content="选择"
                    Classes="primary"
                    Command="{Binding SelectSourceFileCommand}"/>
            </Grid>
            <ProgressBar
                Grid.Row="4"
                Minimum="0"
                Maximum="100"
                Value="{Binding Progress}"/>
        </Grid>
    </Grid>

</Window>
